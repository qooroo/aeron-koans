<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.aeron.koans.sbe"
                   id="1"
                   version="0"
                   semanticVersion="5.2"
                   description="Aeron Koans SBE messages: FIX subset + Ping/Pong"
                   byteOrder="littleEndian">

    <types>
        <!-- Standard 8-byte SBE message header -->
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId"   primitiveType="uint16"/>
            <type name="version"    primitiveType="uint16"/>
        </composite>

        <!-- Variable-length ASCII string encoding (4-byte length prefix) -->
        <composite name="varAsciiEncoding">
            <type name="length"  primitiveType="uint32" maxValue="1073741824"/>
            <type name="varData" primitiveType="uint8"  length="0" characterEncoding="ASCII"/>
        </composite>

        <!-- FIX Side enum -->
        <enum name="Side" encodingType="uint8">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>

        <!-- FIX OrdType enum (subset) -->
        <enum name="OrdType" encodingType="uint8">
            <validValue name="MARKET">0</validValue>
            <validValue name="LIMIT">1</validValue>
        </enum>

        <!-- FIX ExecType enum (subset) -->
        <enum name="ExecType" encodingType="uint8">
            <validValue name="NEW">0</validValue>
            <validValue name="FILLED">1</validValue>
            <validValue name="REJECTED">2</validValue>
        </enum>

        <!-- FIX OrdStatus enum (subset) -->
        <enum name="OrdStatus" encodingType="uint8">
            <validValue name="NEW">0</validValue>
            <validValue name="FILLED">1</validValue>
            <validValue name="REJECTED">2</validValue>
        </enum>
    </types>

    <!-- ===================================================================
         Aeron Messaging: FIX NewOrderSingle (template id=1)
         =================================================================== -->
    <sbe:message name="NewOrderSingle" id="1" description="Minimal FIX NewOrderSingle">
        <!-- Fixed-length fields (block) -->
        <field name="side"     id="1" type="Side"/>
        <field name="ordType"  id="2" type="OrdType"/>
        <field name="orderQty" id="3" type="double"/>
        <field name="price"    id="4" type="double"/>
        <!-- Variable-length fields (appended after block) -->
        <data  name="clOrdId"  id="5" type="varAsciiEncoding"/>
        <data  name="symbol"   id="6" type="varAsciiEncoding"/>
    </sbe:message>

    <!-- ===================================================================
         Aeron Messaging: FIX ExecutionReport (template id=2)
         =================================================================== -->
    <sbe:message name="ExecutionReport" id="2" description="Minimal FIX ExecutionReport">
        <field name="execType"  id="1" type="ExecType"/>
        <field name="ordStatus" id="2" type="OrdStatus"/>
        <field name="side"      id="3" type="Side"/>
        <field name="leavesQty" id="4" type="double"/>
        <field name="cumQty"    id="5" type="double"/>
        <field name="avgPx"     id="6" type="double"/>
        <data  name="orderId"   id="7" type="varAsciiEncoding"/>
        <data  name="clOrdId"   id="8" type="varAsciiEncoding"/>
        <data  name="execId"    id="9" type="varAsciiEncoding"/>
        <data  name="symbol"    id="10" type="varAsciiEncoding"/>
    </sbe:message>

    <!-- ===================================================================
         Aeron Archive: Ping (template id=3)
         =================================================================== -->
    <sbe:message name="Ping" id="3" description="Ping message for archive example">
        <field name="id"         id="1" type="int64"/>
        <field name="sendTimeNs" id="2" type="int64"/>
    </sbe:message>

    <!-- ===================================================================
         Aeron Archive: Pong (template id=4)
         =================================================================== -->
    <sbe:message name="Pong" id="4" description="Pong message for archive example">
        <field name="id"         id="1" type="int64"/>
        <field name="sendTimeNs" id="2" type="int64"/>
    </sbe:message>

</sbe:messageSchema>
